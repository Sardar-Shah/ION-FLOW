# MongoDB Atlas URI connection string:
# Format: mongodb+srv://<DB_USERNAME>:<NEW_PASSWORD>@ionflow.skdrbqo.mongodb.net/careerpath_ai?appName=IONFLOW
# Set this privately in Google AI Studio Server Secrets or your host environment.
MONGODB_URI="mongodb+srv://<DB_USERNAME>:<NEW_PASSWORD>@ionflow.skdrbqo.mongodb.net/careerpath_ai?appName=IONFLOW"

# JWT Secret for signing authentication tokens
JWT_SECRET="careerpath_ai_secure_jwt_secret_key_university_2026"

# Port for the server (defaults to 3000 in dev)
PORT="3000"

# GEMINI_API_KEY: Optional if AI features are configured.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

